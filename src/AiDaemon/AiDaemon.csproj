<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AiDaemon</RootNamespace>
    <AssemblyName>AiDaemon</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      WinExe sets the PE subsystem to GUI (2) instead of Console (3), so Windows does NOT
      allocate a console window when the scheduled task launches AiDaemon.exe at logon.
      The tray icon (see TrayHost) is the visible surface; the console would just be noise.
      `dotnet run` still pipes stdout/stderr because the dotnet host redirects them via
      pipes regardless of the child's subsystem; developer ergonomics are unaffected.
      The Serilog console sink writes to a null stream under WinExe (harmless); the file
      sink under C:\ProgramData\AiDaemon\logs\ is the authoritative log.
    -->
    <OutputType>WinExe</OutputType>
    <!--
      UseWindowsForms is needed for NotifyIcon (system tray icon). The TFM is already
      net10.0-windows so we're not pulling in any extra platform constraint; this just
      adds the WinForms reference and the WPF/WinForms framework pack. The host stays a
      plain BackgroundService worker; the tray icon runs on its own STA thread so we
      don't accidentally turn the daemon into a UI-thread-bound app.
    -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\app-paused.ico" />
    <None Remove="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <!--
    Keep appsettings.Development.json out of `dotnet publish` output. We DO want it at
    bin/ time so `dotnet run` picks up Debug logging + 10s poll interval, but shipping it
    means anyone flipping DOTNET_ENVIRONMENT=Development on the prod service box would
    silently inherit those dev settings. The SDK's CopyToPublishDirectory="Never"
    metadata on <None Update> items is not honored reliably across SDK versions, so we
    remove the file explicitly from ResolvedFileToPublish before the copy stage runs.
  -->
  <Target Name="ExcludeDevelopmentAppsettingsFromPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'appsettings.Development.json'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app-paused.ico" />
    <EmbeddedResource Include="Resources\app.ico" />
    <EmbeddedResource Include="Resources\app_old.ico" />
    <EmbeddedResource Include="Storage\Schema.sql" />
    <EmbeddedResource Include="Triage\system-prompt.md" />
    <EmbeddedResource Include="Triage\pre-run-prompt.md" />
    <EmbeddedResource Include="Triage\schema.json" />
    <EmbeddedResource Include="Triage\pre-run-schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AiDaemon.Tests" />
  </ItemGroup>

</Project>
